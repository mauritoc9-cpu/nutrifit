# Copiá este archivo a ".env" (sin el ".example") y completá al menos una
# de las dos API keys. ".env" nunca se sube a git — está en .gitignore.
# El escáner prueba primero Gemini y, si no está configurada, Claude.

# GRATIS, sin tarjeta de crédito — conseguila en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Asistente: mantener 0 hasta confirmar Paid Services/tratamiento de datos.
# No habilitar solamente por tener una API key configurada.
# Las preguntas generales sólo necesitan la clave y consentimiento de mensajes en la interfaz.
# Consultar registros dentro de NutriFit no requiere activar el envío al proveedor.
ASISTENTE_GEMINI_DATOS_HABILITADOS=0
ASISTENTE_GEMINI_MODELO=gemini-3.6-flash
ASISTENTE_LIMITE_MINUTO=6

# De pago (centavos de dólar por foto) — conseguila en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GRATIS, sin tarjeta de crédito — alta en https://api.data.gov/signup
# Fuente nutricional para alimentos genéricos/preparados (USDA FoodData
# Central). Si se deja vacía, se usa DEMO_KEY (límite bajo: 30/hora, 50/día).
USDA_FDC_API_KEY=

# Catálogo de alimentos y marcas ARGENTINAS (https://nutricion-api-arg.fly.dev).
# Plan gratuito con cuota mensual chica (~1000 requests/mes medido en
# pruebas) — se usa con moderación (ver AlimentoRepository::buscarCodulia).
# Si se deja vacía, el motor sigue funcionando solo con USDA/Open Food Facts.
CODULIA_API_KEY=

# Explorar: opcionales, valores públicos por defecto. Sin credenciales para localhost.
# URLs HTTPS de proveedores compatibles; reemplazar al escalar a producción.
# EXPLORE_PHOTON_URL=https://photon.komoot.io/api/
# EXPLORE_OVERPASS_URL=https://overpass-api.de/api/interpreter
# EXPLORE_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# La URL de tiles se entrega al navegador: NO colocar secretos ni tokens privados.
