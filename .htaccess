Options -Indexes
RewriteEngine On
# Heroku termina TLS en su router: forzar HTTPS (cámara, GPS y cookies Secure lo requieren).
# XAMPP no envía este encabezado, así que localhost no se ve afectado.
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Archivos ocultos y fuentes internas: el frontend y /backend/api siguen públicos.
RewriteRule (^|/)\. - [F,END]
RewriteRule ^(?:database|documentacion|tests)(?:/|$) - [F,END,NC]
RewriteRule ^backend/(?!api(?:/|$)) - [F,END,NC]
<FilesMatch "(?i)\.(sql|log|ini|ya?ml|toml|bak|sh)$|^(composer\.(json|lock)|Procfile|README\.md|AGENTS\.md)$">
    Require all denied
</FilesMatch>
